# Copy to backend/.env if you want (that file is gitignored).
# Never put LiveKit Cloud, Supabase, or Azure secrets in git.
#
# Local `livekit-server --dev` does not need these set: the token service
# falls back to LiveKit's published dev-mode key pair. See the README.
# For LiveKit Cloud, set all three to that project's values.

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

PORT=3001

# Comma-separated browser origins allowed to call /api/token.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
