{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit && vite build",
    "build:staging": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit && vite build --mode staging",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "load": "playwright test -c load/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "livekit-client": "^2.15.14",
    "livekit-server-sdk": "^2.13.3",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
