# Copy to frontend/.env.local if you need overrides (gitignored).
# Do not put Supabase, Azure, or LiveKit secrets here. The LiveKit API secret
# belongs on the token service only.

# Leave unset in local dev to use the Vite proxy at /api/token.
# Production / Vercel: absolute URL of the deployed token service.
# VITE_TOKEN_URL=https://office-token.example.com/api/token

# dev (phase 1) or supabase (later). Tests use dev name entry.
VITE_AUTH_PROVIDER=dev

# QA hooks (window.__qa). The dev server turns them on unless this is false.
# Staging: set VITE_QA_HOOKS=true in the host environment for `vite build --mode staging`.
# Production mode (`vite build`) never installs hooks, even if this is true.
# VITE_QA_HOOKS=

# Supabase Auth Azure provider. Fill these only in a gitignored env file or the host.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
