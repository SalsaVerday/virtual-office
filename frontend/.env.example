# Copy to frontend/.env.local (gitignored). Vite loads it for `npm run dev`.
# Do not commit real cloud secrets. The values below are LiveKit's published
# `livekit-server --dev` pair (API key devkey, secret secret). They are not a
# cloud credential. Production refuses that secret.
#
# /api/token fails closed when any of the three LIVEKIT_ variables is missing.
# There is no in-process fallback.

# --- LiveKit (server only; the Vite dev server reads these for /api/token) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Comma-separated browser origins allowed to call /api/token from another host.
# Same-origin dev (the Vite server) does not need this.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# dev (default, name entry, tests and staging QA) or azure (Entra via Supabase).
# The server flag must match. Leave unset for dev.
# AUTH_PROVIDER=dev
# VITE_AUTH_PROVIDER=dev

# Staging preview only. Ignored when VERCEL_ENV=production.
# ALLOW_DEV_LOGIN=true

# --- Supabase (browser). The anon key is public. Not a service role key. ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Supabase (server, token gate). Never prefix these with VITE_. ---
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=

# Entra tenant id. Required when AUTH_PROVIDER=azure. The Azure client secret
# stays in the Supabase dashboard, not here.
# AZURE_TENANT_ID=

# Leave unset to use same-origin /api/token (Vite dev server or Vercel).
# VITE_TOKEN_URL=

# QA hooks (window.__qa). On for `npm run dev` and `vite build --mode staging`
# unless this is false. `vite build` (production) never installs them.
# VITE_QA_HOOKS=

# Auto-away. Defaults: 180000 ms idle, 20000 ms hidden tab. Focus is not overridden.
# VITE_IDLE_MS=
# VITE_HIDDEN_MS=
